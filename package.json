{
  "name": "sepiolitemine-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "sepiolitemine.com — Astro 4 + Cloudflare Pages. Rentable B2B sepiolite supplier site.",
  "scripts": {
    "preimages": "node scripts/optimize-images.mjs",
    "preog": "npm run preimages",
    "prebuild": "node scripts/generate-og.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:api": "tsc -p tsconfig.api.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sepiolitemine-quotes --local",
    "db:migrate:remote": "wrangler d1 migrations apply sepiolitemine-quotes --remote",
    "dev:api": "wrangler pages dev dist --port 8788",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.7.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "astro": "^5.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "pdf-lib": "^1.17.1",
    "preact": "^10.29.8",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.33.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
